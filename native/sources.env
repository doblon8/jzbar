# Pinned upstream sources for the native builds (read by .github/workflows/native-*.yaml).
# Only NAME=value lines count: no quotes, no spaces. To upgrade, change VERSION and SHA256 together.
#
# ZBar: official release tarball from linuxtv.org, checked against git tag 0.23.93
#   (no differences in sources; only generated autotools/gettext files were added).
# libiconv: tarball SHA-256 above is what the workflows enforce. Provenance, checked
#   once on 2026-10-27:
#   - GPG signature (made 2026-03-07) verified with key
#     E0FF BD97 5397 F77A 32AB 76EC B630 1D9E 1BBE AC08 (Bruno Haible, ed25519,
#     created 2025-01-28, expires 2030-01-27). It is not the key that signed 1.17
#     (9001 B85A F9E1 B83D F1BD A942 F5BE 8B26 7C6A 406D). gpg does not certify the
#     new key: it only carries a self-signature, with no web of trust.
#   - Same fingerprint pinned in Arch Linux's libiconv package (validpgpkeys of the
#     1.19 PKGBUILD, https://gitlab.archlinux.org/archlinux/packaging/packages/libiconv),
#     and the key file in that repo's keys/pgp/ has this fingerprint.
#   - SHA-512 of libiconv-1.19.tar.gz equals the one in that package's PKGBUILD:
#     1e8150f9bca907579330cd9c44ebbee46a260271fbe8f50d5ee24a39ef29c8d254505e85c3409324f7440596da711a8bd49e89f848a6be0cb3238a58c24aaecd
# ICONV_GPG_FPR is documentation only; CI does not check signatures.

ZBAR_VERSION=0.23.93
ZBAR_SHA256=83be8f85fc7c288fd91f98d52fc55db7eedbddcf10a83d9221d7034636683fa0
ICONV_VERSION=1.19
ICONV_SHA256=88dd96a8c0464eca144fc791ae60cd31cd8ee78321e67397e25fc095c4a19aa6
ICONV_GPG_FPR=E0FFBD975397F77A32AB76ECB6301D9E1BBEAC08

# Where the source bundle for this release is published (see THIRD-PARTY-NOTICES).
# Must point at the tag of the pom.xml version; CI checks it.
SOURCE_BUNDLE_URL=https://github.com/doblon8/jzbar/releases/download/v0.4.1/jzbar-native-sources-0.4.1.tar.gz