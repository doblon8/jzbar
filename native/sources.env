# Pinned upstream sources for the native builds (read by .github/workflows/native-*.yaml).
# Only NAME=value lines count: no quotes, no spaces. To upgrade, change VERSION and SHA256 together.
#
# ZBar: release tarball zbar-0.23.95.tar.gz from linuxtv.org (the SHA-256 below is what
#   the workflows enforce). Provenance, checked once on 2026-10-21:
#   - Contents identical (diff -r) to `git archive` of tag 0.23.95 (commit
#     dc19fcc7da58e8cf84ba1ec417e24b04609feb23) and to the GitHub archive tarball used
#     by Fedora's zbar package, whose SHA-512 is
#     cc6e1f39f0f709743e4fe4a375fa3295ad90941f59f37e75d4f862a9826a547645d7a856a159911ed44324e747d6e33dcd793d63dcdef51ec6847da4b98b0049
#     (the tarball hashes differ only because the archives are packaged differently).
#   - Tag signature verified with key F909 AE68 FC11 DF09 C175 5C00 085F 3EBD 8EE4 E115
#     (Mauro Carvalho Chehab). The key was fetched from github.com/mchehab.gpg and its
#     fingerprint matches keys/085F3EBD8EE4E115.asc in kernel.org's pgpkeys repository.
#     gpg does not certify it (no web of trust).
#   - Unlike 0.23.93, the tarball has no generated autotools files: it builds with meson only.
# libiconv: tarball SHA-256 above is what the workflows enforce. Provenance, checked
#   once on 2026-10-17:
#   - GPG signature (made 2022-05-15) verified with key
#     9001 B85A F9E1 B83D F1BD A942 F5BE 8B26 7C6A 406D (Bruno Haible); the key has
#     since expired, which does not affect an earlier signature.
#   - Same fingerprint pinned in Arch Linux's libiconv package
#     (https://gitlab.archlinux.org/archlinux/packaging/packages/libiconv),
#     and imported from that repo's keys/pgp/ file.
#   - SHA-512 of libiconv-1.17.tar.gz equals the one in that package's PKGBUILD:
#     18a09de2d026da4f2d8b858517b0f26d853b21179cf4fa9a41070b2d140030ad9525637dc4f34fc7f27abca8acdc84c6751dfb1d426e78bf92af4040603ced86
# ICONV_GPG_FPR is documentation only; CI does not check signatures.

ZBAR_VERSION=0.23.95
